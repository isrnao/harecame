# Copy to .env.local and replace values. Never commit actual credentials.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
JWT_SECRET=
ADMIN_KEY=
# Public HTTPS origin reachable by LiveKit Egress (not localhost in production).
APP_URL=
# YouTube channel with livestreaming enabled; OAuth youtube.force-ssl scope.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Secret used by scripts/run-stream-worker.mjs; do not expose to browsers.
RECONCILE_SECRET=
# Optional: worker can contact an internal origin different from APP_URL.
WORKER_APP_URL=http://127.0.0.1:3000

# Optional authenticated proxy headers; see docs/streaming-operations.md.
# Without this secret, rate limits use a shared bucket (forwarded IP headers are ignored).
TRUSTED_PROXY_SECRET=
